RADAR_API_BASE_URL=https://your-api-id.execute-api.your-region.amazonaws.com

# Sign up at https://twelvedata.com and paste your API key below — used
# server-only by app/api/stocks/route.ts, never exposed to the browser.
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Public HTTPS URL to the stocks/latest.json object the scraper writes —
# see DEPLOYMENT.md's European stocks addendum for the bucket-policy step
# that makes just this one object public.
EU_STOCKS_S3_URL=https://your-bucket.s3.your-region.amazonaws.com/stocks/latest.json

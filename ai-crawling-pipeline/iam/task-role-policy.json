{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RadarArticlesTableAndIndexes",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/radar-articles",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/radar-articles/index/*"
      ]
    },
    {
      "Sid": "RadarFetchArchiveBucket",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<FETCH_BUCKET_NAME>/*"
    }
  ]
}
